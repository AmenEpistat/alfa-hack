  "required": [
    "schema_version",
    "run_id",
    "input_run_id",
    "input_canonical_sha256",
    "generated_at",
    "status",
    "company_input",
    "target_audience",
    "product_catalog",
    "input_status",
    "input_already_ranked",
    "generation_policy",
    "insights",
    "errors",
    "input_warnings",
    "limitations",
    "usage"
  ],
  "title": "GenerationResult",
  "type": "object"
}
