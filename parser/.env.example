ALPHA_DATA_DIR=../output/runs
ALPHA_INPUT_DIR=inputs
ALPHA_CONFIG_DIR=config
ALPHA_LLM_BASE_URL=
# Organizer-provided backup. Leave empty for other providers.
ALPHA_LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1
ALPHA_LLM_API_KEY=
# Set actual deployment ID from the provided access; family is checked separately.
ALPHA_LLM_MODEL=
ALPHA_LLM_FAMILY=GLM-5.3-Flash
ALPHA_LLM_TIMEOUT=45
ALPHA_LLM_MAX_OUTPUT_TOKENS=1536
ALPHA_LLM_REASONING_EFFORT=low
ALPHA_LLM_LENGTH_RETRIES=1
ALPHA_LLM_CONNECT_TIMEOUT=5
ALPHA_SEARXNG_URL=http://127.0.0.1:8888
ALPHA_INPUT_RUB_PER_MILLION=
ALPHA_OUTPUT_RUB_PER_MILLION=
ALPHA_DAILY_BUDGET_RUB=500
# Explicit acknowledgement required before a paid call with unknown prices.
ALPHA_ALLOW_UNKNOWN_COST=false
ALPHA_MAX_STEPS=8
ALPHA_MAX_PAGES=6
ALPHA_MAX_REQUESTS=18
ALPHA_MAX_TOKENS=12000
ALPHA_BROWSER_FALLBACK=false
ALPHA_OCR_ENABLED=true
ALPHA_TESSDATA=data/tessdata
ALPHA_OCR_LANGUAGE=rus+eng
ALPHA_OCR_DPI=200
ALPHA_TESSERACT_CMD=tesseract
ALPHA_OCR_TIMEOUT=60
# Generated by scripts/setup_integrations.py. No real secrets in this template.
SEARXNG_SECRET=


# Explicit provider-specific mode, opt-in. Keep defaults for current GLM setup.
ALPHA_LLM_THINKING_PROTOCOL=legacy
ALPHA_LLM_THINKING_MODE=default
# For tested Qwen/Kimi OpenRouter routes: protocol=openrouter, mode=instant.
