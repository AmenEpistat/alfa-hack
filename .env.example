APP_PORT=8080
ALPHA_LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
ALPHA_LLM_API_KEY=
ALPHA_LLM_MODEL=
ALPHA_LLM_FAMILY=GLM-5.3-Flash
ALPHA_DAILY_BUDGET_RUB=500
# For a real local budget cap, set both prices and change ALPHA_ALLOW_UNKNOWN_COST to false.
ALPHA_INPUT_RUB_PER_MILLION=
ALPHA_OUTPUT_RUB_PER_MILLION=
ALPHA_ALLOW_UNKNOWN_COST=true
ALPHA_OCR_ENABLED=true
ALPHA_OCR_LANGUAGE=rus+eng
# Built-in search: docker compose --profile search up --build --wait
# Or replace with an existing SearXNG URL reachable from api.
ALPHA_SEARXNG_URL=http://searxng:8080
# Internal local service only; replace before exposing search outside Docker.
SEARXNG_SECRET=local-development-only-change-for-deployment
